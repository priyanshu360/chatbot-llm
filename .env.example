# LLM Provider API Keys
# At least one is required for the chatbot to work.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# PostgreSQL — matches infra/docker-compose.yml defaults
POSTGRES_USER=llmuser
POSTGRES_PASSWORD=llmpass
POSTGRES_DB=llmlog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis — matches infra/docker-compose.yml defaults
REDIS_HOST=localhost
REDIS_PORT=6379

# Service ports (override if ports conflict)
CHAT_API_PORT=4000
INGESTION_API_PORT=4001

# Grafana — matches infra/docker-compose.yml defaults
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Internal: hostname of the ingestion API from the chat-api container
# Only needed when services are containerized separately
INGESTION_HOST=localhost
