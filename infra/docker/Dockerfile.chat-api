FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY services/chat-api/go.mod services/chat-api/go.sum ./services/chat-api/
COPY pkg/go.mod ./pkg/
COPY . .
RUN cd services/chat-api && go mod download && CGO_ENABLED=0 go build -o /server ./cmd/server

FROM alpine:3.20
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /server /server
EXPOSE 4000
ENTRYPOINT ["/server"]
