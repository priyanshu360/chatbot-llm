FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY services/ingestion-api/go.mod services/ingestion-api/go.sum ./services/ingestion-api/
COPY . .
RUN cd services/ingestion-api && go mod download && CGO_ENABLED=0 go build -o /server ./cmd/server && \
    CGO_ENABLED=0 go build -o /worker ./cmd/worker

FROM alpine:3.20
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /server /server
COPY --from=builder /worker /worker
EXPOSE 4001
ENTRYPOINT ["/server"]
